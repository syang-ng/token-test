# Ethereum Sepolia RPC; use your provider's endpoint.
SEPOLIA_RPC_URL=https://your-sepolia-rpc.example
# Use this existing project variable to sign directly from the environment.
# Keep the actual private key only in your local .env.
DEPLOYER_PRIVATE_KEY=
# Alternative: omit DEPLOYER_PRIVATE_KEY and configure a keystore below.
# Public address of the keystore account that will own both contracts.
# DEPLOYER_ADDRESS=
# Name created with: cast wallet import sepolia-demo --interactive
# FOUNDRY_ACCOUNT=sepolia-demo
# Optional absolute path for unattended deployment; otherwise Foundry prompts.
# KEYSTORE_PASSWORD_FILE=

# USDC and EURC both use 6 decimals. 1000000 = 1 token per callback per asset.
MAX_CALLBACK_PAYMENT=1000000
# Demo token uses 18 decimals by default. 100000000000000000000 = 100 tokens.
AIRDROP_AMOUNT=100000000000000000000
TOKEN_NAME="Good Token"
TOKEN_SYMBOL=GTK
TOKEN_DECIMALS=18

# Transfer Trader ownership, then fund it from the new owner's wallet.
# DEPLOYER_PRIVATE_KEY above must belong to the CURRENT Trader owner.
# Both owners need Sepolia ETH; the new owner also needs 1 USDC and 1 EURC.
NEW_OWNER_ADDRESS=
NEW_OWNER_PRIVATE_KEY=
# Optional: otherwise read from deployments/sepolia.json.
# TRADER_ADDRESS=
